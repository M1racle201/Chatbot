# 敏感文件: API 密钥不提交
.env

# 运行时数据目录(统一收拢到 data/,挂载卷/本地数据,不入库)
data/
.hf_cache/

# Python 打包产物
build/
dist/
*.egg-info/
.pytest_cache/

# 历史记录与任务存档 JSON
*.json

# Python
__pycache__/
*.pyc
.venv/

# 系统提示词(本地内容,不提交)
prompt/*
!prompt/system
!prompt/rewriter
!prompt/executor
!prompt/verifier


# Node / Ink UI
ui/node_modules/
ui/.build/

# UI 清单文件需要提交（其余 JSON 仍按 *.json 忽略）
!ui/package.json
!ui/package-lock.json
ui/VECTOR_DB/
ui/AGENTIC/
ui/CHAT/
ui/TASK/
ui/OUTPUT/
